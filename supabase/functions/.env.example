# Configure these values as Supabase Edge Function secrets, never in www/ or the PWA.
# Local: supabase functions serve --env-file supabase/functions/.env.local
# Deploy: supabase secrets set --env-file supabase/functions/.env.local
ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
